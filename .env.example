# Copy thành .env rồi điền key
# Đăng ký miễn phí: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Giai đoạn 2: daily brief ──
# Provider: claude_cli (mặc định, dùng Claude Code sẵn có) | claude_api | gemini
BRIEF_PROVIDER=claude_cli
# Chỉ cần khi BRIEF_PROVIDER=claude_api (model đổi qua BRIEF_MODEL, mặc định claude-opus-5)
ANTHROPIC_API_KEY=
# Chỉ cần khi BRIEF_PROVIDER=gemini (miễn phí: aistudio.google.com)
GEMINI_API_KEY=
# Model Gemini: flash-lite ổn định nhất trên free tier (flash hay 503 với request dài)
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Cảnh báo Telegram (không điền thì chỉ in console) ──
# Tạo bot: nhắn @BotFather trên Telegram; lấy chat id: nhắn bot rồi mở
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
